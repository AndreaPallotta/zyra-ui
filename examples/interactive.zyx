import "../src/lib.zy"

def InteractiveView(): String {
  const crumbs = Breadcrumb("Zyra Cloud, Telemetry & Operations, Interactive Showcase".to_string())

  const toast_info = Toast("Autoscale Triggered".to_string(), "Worker group scaled to 8 instances".to_string(), "info".to_string())

  const code_sample = CodeBlock("import \"github.com/AndreaPallotta/zyra-ui\"\n\ndef main(): Int {\n  print(\"Running Zyra UI interactive micro-runtime!\")\n  return 0\n}".to_string(), "zyra".to_string())

  const spark1 = Sparkline("0,25 15,20 30,12 45,18 60,8 75,14 90,6 105,10 120,4".to_string(), "primary".to_string(), 32)
  const spark2 = Sparkline("0,4 15,6 30,5 45,8 60,6 75,5 90,4 105,5 120,3".to_string(), "success".to_string(), 32)

  const card_spark1 = Card("Ingress Traffic".to_string(), "Live req/s telemetry".to_string(), "<div class=\"flex items-center justify-between\"><span class=\"text-2xl font-bold\">48.2k</span>" + spark1 + "</div>", "".to_string())
  const card_spark2 = Card("Health Index".to_string(), "System resilience score".to_string(), "<div class=\"flex items-center justify-between\"><span class=\"text-2xl font-bold\">99.98%</span>" + spark2 + "</div>", "".to_string())
  const grid_metrics = Grid(2, card_spark1 + &card_spark2)

  const skel_1 = Skeleton("circle".to_string(), "48px".to_string(), "48px".to_string())
  const skel_2 = Skeleton("rect".to_string(), "100%".to_string(), "20px".to_string())
  const skel_3 = Skeleton("rect".to_string(), "70%".to_string(), "16px".to_string())
  const skel_block = "<div class=\"flex items-center gap-4\">" + skel_1 + "<div class=\"flex flex-col gap-2 flex-1\">" + &skel_2 + &skel_3 + "</div></div>"
  const card_skeletons = Card("Skeleton Loading State".to_string(), "Animated shimmer placeholder elements".to_string(), skel_block, "".to_string())

  const btn_modal = "<button class=\"btn btn-primary btn-sm\" data-modal-open=\"sample-modal\">Launch Modal</button>"
  const btn_drawer = "<button class=\"btn btn-secondary btn-sm\" data-drawer-open=\"sample-drawer\">Open Drawer</button>"
  const drop = Dropdown("Quick Actions".to_string(), "Trigger Backup, Rollback Deployment, Flush Cache".to_string())
  const tip = Tooltip("Clicking will trigger safe drain".to_string(), "<button class=\"btn btn-outline btn-sm\">Drain Nodes</button>".to_string())
  const actions_row = "<div class=\"flex flex-wrap gap-4 items-center mb-4\">" + btn_modal + &btn_drawer + &drop + &tip + "</div>"

  const panel_overview_content = actions_row + &code_sample
  const panel_overview = TabPanel("Overview".to_string(), true, panel_overview_content)

  const panel_metrics_content = grid_metrics + "<div class=\"mb-6\"></div>" + &card_skeletons
  const panel_metrics = TabPanel("Metrics".to_string(), false, panel_metrics_content)

  const headers = "Timestamp, Actor, Action, Status"
  const rows = "19:00:02, operator-1, Cluster autoscale +2 nodes, COMPLETED; 18:45:10, ci-bot, Deploy microservices v2.5.0, SUCCESS; 18:30:00, security, Vault token rotation, OK"
  const table_html = DataTable(headers.to_string(), rows.to_string())
  const pager = Pagination(1, 5)
  const audit_body = table_html + "<div class=\"flex justify-between items-center mt-4\"><span class=\"text-sm text-muted\">Showing 1-3 of 15 entries</span>" + &pager + "</div>"
  const panel_audit = TabPanel("Audit".to_string(), false, audit_body)

  const acc1 = Accordion("Edge CDN Routing Policy".to_string(), "<p>Anycast IP routing enabled across 18 edge POPs worldwide.</p>".to_string(), true)
  const acc2 = Accordion("Cold Storage Archival".to_string(), "<p>Automated snapshot replication every 6 hours with 30-day lifecycle.</p>".to_string(), false)
  const empty = EmptyState("No Custom Integrations".to_string(), "Connect your cloud monitoring pipelines or webhook endpoints".to_string(), "<button class=\"btn btn-primary btn-sm\">+ Add Integration</button>".to_string())
  const panel_settings_content = "<div class=\"accordion-group mb-6\">" + acc1 + &acc2 + "</div>" + &empty
  const panel_settings = TabPanel("Settings".to_string(), false, panel_settings_content)

  const panels = panel_overview + &panel_metrics + &panel_audit + &panel_settings
  const tabs = Tabs("Overview, Metrics, Audit, Settings".to_string(), "Overview".to_string(), panels)

  const modal = Modal("sample-modal".to_string(), "Deploy Verification".to_string(), "<p>Are you sure you want to execute canary deployment across all edge nodes?</p>".to_string(), "<button class=\"btn btn-secondary btn-sm\" data-modal-close>Cancel</button><button class=\"btn btn-primary btn-sm\" data-modal-close>Confirm</button>".to_string())

  const drawer = Drawer("sample-drawer".to_string(), "System Details".to_string(), "<p>Kernel version: 6.8.0-zyra</p><p class=\"mt-2\">Memory usage: 4.2 GB / 16 GB</p><p class=\"mt-2\">Uptime: 99.99%</p><button class=\"btn btn-secondary btn-sm mt-6\" data-drawer-close>Close</button>".to_string(), true)

  const page_body = crumbs + "<div class=\"flex justify-between items-center my-4\"><h1 class=\"text-3xl font-bold\">Interactive Micro-Runtime</h1>" + &toast_info + "</div>" + &tabs + &modal + &drawer
  return render_themed_page("Zyra UI Interactive Showcase".to_string(), "<div class=\"container\">" + &page_body + "</div>", theme_nord(), "".to_string())
}

def main(): Int {
  const html = InteractiveView()
  print("[OK] Interactive showcase generated successfully:")
  print(&html[..320])
  return 0
}
