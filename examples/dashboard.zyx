import "../src/lib.zy"

def DashboardView(): String {
  const alert_box = Alert("All Systems Operational".to_string(), "Global edge clusters running nominal across all 14 regions.".to_string(), "success".to_string())

  const stat_1 = StatCard("Active Services".to_string(), "48".to_string(), "4 new".to_string(), true)
  const stat_2 = StatCard("Total Requests".to_string(), "14.2M".to_string(), "12.5%".to_string(), true)
  const stat_3 = StatCard("P99 Latency".to_string(), "18ms".to_string(), "3ms slower".to_string(), false)
  const stat_cards = stat_1 + &stat_2 + &stat_3
  const stats_grid = Grid(3, stat_cards)

  const headers = "Service Name, Cluster, Traffic, Uptime, Status"
  const rows = "auth-gateway, us-east-1, 4.2k req/s, 99.99%, Active; billing-api, us-east-1, 1.1k req/s, 99.95%, Active; search-indexer, eu-west-1, 850 req/s, 99.90%, Active; analytics-worker, ap-northeast-1, 620 req/s, 98.50%, Degraded"
  const table_html = DataTable(headers.to_string(), rows.to_string())

  const table_card = Card("Active Microservices".to_string(), "Live production telemetry and health status".to_string(), table_html, "<span class=\"text-muted text-xs\">Last synced: 10 seconds ago</span>".to_string())

  const header = SectionHeader("Operations Overview".to_string(), "Monitor mission-critical infrastructure and deployed workloads".to_string())

  const content = header + &alert_box + &stats_grid + "<div class=\"mb-6\"></div>" + &table_card
  return render_dashboard("ZyraOps Cloud Dashboard".to_string(), "ZyraOps".to_string(), "Overview, Metrics, Deployments, Settings".to_string(), "Overview".to_string(), content, theme_nord())
}

def main(): Int {
  const html = DashboardView()
  print("[OK] Dashboard HTML generated successfully:")
  print(&html[..280])
  return 0
}
