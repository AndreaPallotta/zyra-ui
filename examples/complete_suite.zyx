import "../src/lib.zy"

def CompleteSuiteView(): String {
  const banner = Banner("Feature Release v2.5".to_string(), "The full 100% component suite is now live.".to_string(), "Learn More".to_string(), "primary".to_string())
  const nav = Navbar("ZyraUI Complete".to_string(), "Showcase,Forms,Layout,Charts,Navigation".to_string(), "Showcase".to_string(), ThemeToggle() + " " + NotificationCenter(5, "New build available;Security audit passed;Deploy finished".to_string()))

  const step_bar = Stepper("Draft,Review,Staging,Production".to_string(), 3)

  const kpi_1 = KpiComparison("Throughput".to_string(), "48.2k rps".to_string(), "35.0k rps".to_string(), "50.0k rps".to_string(), "37.7".to_string(), true)
  const kpi_2 = KpiComparison("Latency P99".to_string(), "4.2 ms".to_string(), "6.8 ms".to_string(), "3.0 ms".to_string(), "38.2".to_string(), true)
  const kpi_grid = Grid(2, kpi_1 + &kpi_2)

  const bar_chart = BarChart("Jan,Feb,Mar,Apr,May,Jun".to_string(), "30,55,40,75,90,110".to_string(), 160, "primary".to_string())
  const donut_chart = DonutChart("Compute,Memory,Storage,Network".to_string(), "45,25,20,10".to_string(), 140)
  const area_chart = AreaChart("0,110 50,80 100,95 150,45 200,60 250,20 300,40".to_string(), "accent".to_string(), 140)
  const prog_ring = ProgressRing(84, 100, 10, "success".to_string())

  const chart_col1 = Card("Resource Allocation".to_string(), "Capacity usage breakdown".to_string(), donut_chart, "".to_string())
  const chart_col2 = Card("Monthly Growth".to_string(), "Telemetry data volume".to_string(), bar_chart, "".to_string())
  const chart_col3 = Card("Request Rate Profile".to_string(), "Continuous pipeline metrics".to_string(), area_chart, "".to_string())
  const chart_col4 = Card("Target Attainment".to_string(), "Q3 SLA completion percentage".to_string(), "<div class=\"flex justify-center p-4\">" + prog_ring + "</div>", "".to_string())
  const charts_grid = Grid(4, chart_col1 + &chart_col2 + &chart_col3 + &chart_col4)

  const sw = Switch("stream_mode".to_string(), "High Frequency Realtime Stream".to_string(), true, false)
  const slider = Slider("poll_interval".to_string(), "Telemetry Sampling Rate (ms)".to_string(), 10, 1000, 250)
  const radio = RadioGroup("format".to_string(), "Output Format".to_string(), "JSON,Protobuf,Arrow".to_string(), "Arrow".to_string())
  const search = SearchInput("metric_query".to_string(), "Filter system metrics...".to_string(), "".to_string())
  const num_in = NumberInput("workers".to_string(), "Concurrent Workers".to_string(), 1, 32, 8)
  const pin = PinInput("mfa".to_string(), 6)
  const tags = TagInput("labels".to_string(), "Filter Labels".to_string(), "edge,nvme,gpu".to_string(), "Add label...".to_string())
  const date_p = DatePicker("start_date".to_string(), "From Date".to_string(), "2026-09-01".to_string())
  const time_p = TimePicker("start_time".to_string(), "Time Slot".to_string(), "09:00".to_string())
  const color_p = ColorPicker("accent_hex".to_string(), "Theme Accent Color".to_string(), "#8b5cf6".to_string())
  const dropzone = DropZone("bundle".to_string(), "Drop manifest file here".to_string(), "Supports YAML, JSON, TOML".to_string(), ".yaml,.json,.toml".to_string())

  const form_content = VStack("gap-4".to_string(), sw + &slider + &radio + &search + &num_in + &pin + &tags + &date_p + &time_p + &color_p + &dropzone)
  const form_card = Card("Runtime Configuration".to_string(), "Interactive form primitives".to_string(), form_content, "".to_string())

  const timeline = Timeline("Boot:Kernel initialised:08:00:00;Sync:Metadata cluster joined:08:00:02;Ready:Accepting traffic:08:00:05".to_string())
  const tree = TreeView("project:folder;core:folder;core/lib.zy:file;tests:folder;tests/test_suite.zy:file;README.md:file".to_string())
  const av_grp = AvatarGroup("Grace,Ada,Margaret,Hedy,Katherine,Joan".to_string(), 4, "md".to_string())
  const stars = Rating(5, 5)
  const diff = DiffViewer("cache_enabled = false".to_string(), "cache_enabled = true;ttl = 3600".to_string())
  const kbd_hint = "<div class=\"p-2 text-xs\">Global Shortcut: " + Kbd("Ctrl+K".to_string()) + " to open Command Palette</div>"
  const carousel = Carousel("<div class=\"p-6 bg-surface-hover text-center font-bold\">Architecture Diagram View 1</div>;<div class=\"p-6 bg-surface-hover text-center font-bold\">Network Topology View 2</div>;<div class=\"p-6 bg-surface-hover text-center font-bold\">Storage Fabric View 3</div>".to_string())

  const display_content = VStack("gap-4".to_string(), "<div class=\"flex items-center justify-between\"><div>" + av_grp + "</div><div>" + stars + "</div></div>" + &timeline + &tree + &diff + &kbd_hint + &carousel)
  const display_card = Card("System Observability".to_string(), "Data display and visual primitives".to_string(), display_content, "".to_string())

  const forms_and_display = Grid(2, form_card + &display_card)

  const popover = Popover("<button class=\"btn btn-secondary btn-sm\">Quick Info Popover</button>".to_string(), "<p>Floating popover content anchored to button trigger.</p>".to_string())
  const hover = HoverCard("<button class=\"btn btn-ghost btn-sm\">Hover Profile</button>".to_string(), "<div class=\"p-2 font-bold\">Zyra Lead Architect</div><p class=\"text-xs text-muted\">Systems Engineering</p>".to_string())
  const confirm = ConfirmDialog("confirm-purge".to_string(), "Purge Snapshot Cache".to_string(), "This action will invalidate all edge caches permanently.".to_string(), "Purge Cache".to_string(), true)
  const cmd = CommandPalette("cmd-box".to_string(), "Type a command or search...".to_string(), "New Service:Ctrl+N;Deploy Cluster:Ctrl+D;Open Docs:Ctrl+H".to_string())
  const lightbox = Lightbox("box-img".to_string(), "https://example.com/system.png".to_string(), "Zyra Edge Architecture 2026".to_string())

  const overlay_bar = HStack("gap-4".to_string(), popover + &hover + "<button class=\"btn btn-danger btn-sm\" data-modal-open=\"confirm-purge\">Trigger Confirm Dialog</button><button class=\"btn btn-primary btn-sm\" data-cmd-open=\"cmd-box\">Launch Command Palette</button>")

  const body = "<div class=\"min-h-screen\">" + banner + nav + "<main class=\"container py-6\"><div class=\"mb-6\">" + step_bar + "</div><div class=\"mb-6\">" + kpi_grid + "</div><div class=\"mb-6\">" + charts_grid + "</div><div class=\"mb-6\">" + forms_and_display + "</div><div class=\"mb-6 card p-4\">" + overlay_bar + "</div></main>" + confirm + cmd + lightbox + "</div>"

  return render_themed_page("Zyra UI Complete Component Suite".to_string(), body, theme_dark(), "".to_string())
}

def main(): Int {
  const html = CompleteSuiteView()
  print("[OK] Complete component suite HTML generated successfully:")
  print(format!("Total HTML document size: {} bytes", len(&html)))
  print(&html[..280])
  return 0
}
