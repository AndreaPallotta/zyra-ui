// zyra-ui - Component-Driven UI Library & Design System for Zyra

struct VNode {
  tag: String,
  classes: String,
  attrs: String,
  text: String,
  children_count: Int,
}

struct StateEntry {
  key: String,
  value: String,
}

struct Theme {
  name: String,
  bg: String,
  surface: String,
  surface_hover: String,
  text: String,
  text_muted: String,
  primary: String,
  primary_hover: String,
  border: String,
  accent: String,
  danger: String,
  success: String,
  warning: String,
  radius: String,
  font_family: String,
}

def h(tag: String, classes: String, text: String): VNode {
  return VNode {
    tag: tag.to_string(),
    classes: classes.to_string(),
    attrs: "".to_string(),
    text: text.to_string(),
    children_count: 0,
  }
}

def div(classes: String, text: String): VNode {
  return h("div", classes, text)
}

def h1(classes: String, text: String): VNode {
  return h("h1", classes, text)
}

def p(classes: String, text: String): VNode {
  return h("p", classes, text)
}

def button(classes: String, label: String): VNode {
  return h("button", classes, label)
}

def input(placeholder: String, value: String): VNode {
  return VNode {
    tag: "input".to_string(),
    classes: "form-input".to_string(),
    attrs: "placeholder=\"" + placeholder + "\" value=\"" + value + "\"",
    text: "".to_string(),
    children_count: 0,
  }
}

def render_html(node: VNode): String {
  if (node.tag == "input") {
    return "<input class=\"" + node.classes + "\" " + node.attrs + " />"
  }

  var html = "<" + node.tag
  if (len(&node.classes) > 0) {
    html = html + " class=\"" + node.classes + "\""
  }
  if (len(&node.attrs) > 0) {
    html = html + " " + node.attrs
  }
  html = html + ">"
  html = html + &node.text
  html = html + "</" + node.tag + ">"
  return html
}

