def theme_to_css(t: Theme): String {
  var css = ":root {\n".to_string()
  css = css + "  --zy-bg: " + &t.bg + ";\n"
  css = css + "  --zy-surface: " + &t.surface + ";\n"
  css = css + "  --zy-surface-hover: " + &t.surface_hover + ";\n"
  css = css + "  --zy-text: " + &t.text + ";\n"
  css = css + "  --zy-text-muted: " + &t.text_muted + ";\n"
  css = css + "  --zy-primary: " + &t.primary + ";\n"
  css = css + "  --zy-primary-hover: " + &t.primary_hover + ";\n"
  css = css + "  --zy-border: " + &t.border + ";\n"
  css = css + "  --zy-accent: " + &t.accent + ";\n"
  css = css + "  --zy-danger: " + &t.danger + ";\n"
  css = css + "  --zy-success: " + &t.success + ";\n"
  css = css + "  --zy-warning: " + &t.warning + ";\n"
  css = css + "  --zy-radius: " + &t.radius + ";\n"
  css = css + "  --zy-font: " + &t.font_family + ";\n"
  css = css + "}\n"
  return css
}

def generate_stylesheet(t: Theme, custom_css: String): String {
  const vars = theme_to_css(t)
  const base_rules = r#"
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background-color: var(--zy-bg);
  color: var(--zy-text);
  font-family: var(--zy-font);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--zy-primary); text-decoration: none; }
a:hover { text-decoration: underline; }

.container { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
.container-sm { max-width: 720px; margin: 0 auto; padding: 1.5rem; }
.container-lg { max-width: 1400px; margin: 0 auto; padding: 1.5rem; }

.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-row { display: flex; flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-start { justify-content: flex-start; }
.justify-end { justify-content: flex-end; }

.grid { display: grid; gap: 1rem; }
.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
.grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }

.gap-1 { gap: 0.25rem; }
.gap-2 { gap: 0.5rem; }
.gap-4 { gap: 1rem; }
.gap-6 { gap: 1.5rem; }
.gap-8 { gap: 2rem; }

.p-2 { padding: 0.5rem; }
.p-4 { padding: 1rem; }
.p-6 { padding: 1.5rem; }
.p-8 { padding: 2rem; }
.px-4 { padding-left: 1rem; padding-right: 1rem; }
.py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.m-0 { margin: 0; }
.m-2 { margin: 0.5rem; }
.m-4 { margin: 1rem; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-4 { margin-bottom: 1rem; }
.mb-6 { margin-bottom: 1.5rem; }

.text-xs { font-size: 0.75rem; }
.text-sm { font-size: 0.875rem; }
.text-base { font-size: 1rem; }
.text-lg { font-size: 1.125rem; }
.text-xl { font-size: 1.25rem; }
.text-2xl { font-size: 1.5rem; }
.text-3xl { font-size: 1.875rem; }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.text-center { text-align: center; }
.text-muted { color: var(--zy-text-muted); }
.text-primary { color: var(--zy-primary); }
.text-success { color: var(--zy-success); }
.text-danger { color: var(--zy-danger); }
.rounded { border-radius: var(--zy-radius); }
.rounded-full { border-radius: 9999px; }
.shadow-sm { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
.shadow-md { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2); }
.shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); }

.card {
  background-color: var(--zy-surface);
  border: 1px solid var(--zy-border);
  border-radius: var(--zy-radius);
  padding: 1.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}
.card-header { margin-bottom: 1rem; }
.card-title { font-size: 1.25rem; font-weight: 700; color: var(--zy-text); }
.card-subtitle { font-size: 0.875rem; color: var(--zy-text-muted); margin-top: 0.25rem; }
.card-body { color: var(--zy-text); }
.card-footer { margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px solid var(--zy-border); font-size: 0.875rem; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  border-radius: var(--zy-radius);
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.2s ease;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
}
.btn:hover { opacity: 0.9; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary { background-color: var(--zy-primary); color: #ffffff; }
.btn-primary:hover { background-color: var(--zy-primary-hover); }
.btn-secondary { background-color: var(--zy-surface-hover); color: var(--zy-text); border: 1px solid var(--zy-border); }
.btn-outline { background-color: transparent; border: 1px solid var(--zy-primary); color: var(--zy-primary); }
.btn-outline:hover { background-color: var(--zy-primary); color: #ffffff; }
.btn-danger { background-color: var(--zy-danger); color: #ffffff; }
.btn-success { background-color: var(--zy-success); color: #ffffff; }
.btn-ghost { background-color: transparent; color: var(--zy-text-muted); }
.btn-ghost:hover { background-color: var(--zy-surface-hover); color: var(--zy-text); }
.btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
.btn-lg { padding: 0.75rem 1.5rem; font-size: 1.125rem; }

.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.2rem 0.6rem;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: 9999px;
  line-height: 1;
}
.badge-primary { background-color: rgba(99, 102, 241, 0.2); color: var(--zy-primary); border: 1px solid var(--zy-primary); }
.badge-secondary { background-color: var(--zy-surface-hover); color: var(--zy-text-muted); }
.badge-success { background-color: rgba(16, 185, 129, 0.2); color: var(--zy-success); border: 1px solid var(--zy-success); }
.badge-warning { background-color: rgba(245, 158, 11, 0.2); color: var(--zy-warning); border: 1px solid var(--zy-warning); }
.badge-danger { background-color: rgba(239, 68, 68, 0.2); color: var(--zy-danger); border: 1px solid var(--zy-danger); }
.badge-info { background-color: rgba(56, 189, 248, 0.2); color: var(--zy-accent); border: 1px solid var(--zy-accent); }
.badge-neutral { background-color: var(--zy-surface-hover); color: var(--zy-text); }

.alert {
  padding: 1rem 1.25rem;
  border-radius: var(--zy-radius);
  border-left: 4px solid var(--zy-primary);
  background-color: var(--zy-surface);
  margin-bottom: 1rem;
}
.alert-title { font-weight: 700; margin-bottom: 0.25rem; }
.alert-msg { font-size: 0.875rem; color: var(--zy-text-muted); }
.alert-info { border-left-color: var(--zy-accent); }
.alert-success { border-left-color: var(--zy-success); }
.alert-warning { border-left-color: var(--zy-warning); }
.alert-danger { border-left-color: var(--zy-danger); }

.stat-card {
  background-color: var(--zy-surface);
  border: 1px solid var(--zy-border);
  border-radius: var(--zy-radius);
  padding: 1.25rem;
}
.stat-title { font-size: 0.875rem; color: var(--zy-text-muted); font-weight: 500; }
.stat-value { font-size: 1.875rem; font-weight: 800; color: var(--zy-text); margin: 0.25rem 0; }
.stat-delta { font-size: 0.875rem; font-weight: 600; display: inline-flex; align-items: center; }
.delta-positive { color: var(--zy-success); }
.delta-negative { color: var(--zy-danger); }

.progress-bg {
  width: 100%;
  background-color: var(--zy-surface-hover);
  border-radius: 9999px;
  height: 0.5rem;
  overflow: hidden;
}
.progress-fill { height: 100%; border-radius: 9999px; transition: width 0.3s ease; }
.progress-primary { background-color: var(--zy-primary); }
.progress-success { background-color: var(--zy-success); }
.progress-danger { background-color: var(--zy-danger); }

.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  border-radius: 9999px;
  background-color: var(--zy-primary);
  color: #ffffff;
}
.avatar-sm { width: 24px; height: 24px; font-size: 0.75rem; }
.avatar-md { width: 36px; height: 36px; font-size: 0.875rem; }
.avatar-lg { width: 48px; height: 48px; font-size: 1.125rem; }

.form-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; }
.form-label { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--zy-text); }
.form-input, .form-select, .form-textarea {
  background-color: var(--zy-bg);
  border: 1px solid var(--zy-border);
  color: var(--zy-text);
  border-radius: var(--zy-radius);
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s ease;
}
.form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--zy-primary); }
.form-error { font-size: 0.75rem; color: var(--zy-danger); margin-top: 0.25rem; }
.form-checkbox-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer; }

.table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; }
.table th { background-color: var(--zy-surface-hover); color: var(--zy-text-muted); font-weight: 600; padding: 0.75rem 1rem; border-bottom: 1px solid var(--zy-border); }
.table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--zy-border); color: var(--zy-text); }
.table tr:hover td { background-color: var(--zy-surface-hover); }

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  background-color: var(--zy-surface);
  border-bottom: 1px solid var(--zy-border);
}
.navbar-brand { font-size: 1.25rem; font-weight: 800; color: var(--zy-text); display: flex; align-items: center; gap: 0.5rem; }
.navbar-nav { display: flex; align-items: center; gap: 1rem; list-style: none; }
.nav-link { color: var(--zy-text-muted); font-weight: 500; font-size: 0.875rem; }
.nav-link:hover, .nav-link-active { color: var(--zy-primary); font-weight: 600; }

.sidebar { width: 260px; background-color: var(--zy-surface); border-right: 1px solid var(--zy-border); min-height: 100vh; padding: 1.5rem 1rem; }
.sidebar-brand { font-size: 1.25rem; font-weight: 800; margin-bottom: 2rem; padding: 0 0.5rem; }
.sidebar-menu { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
.sidebar-item { padding: 0.6rem 0.75rem; border-radius: var(--zy-radius); color: var(--zy-text-muted); font-weight: 500; display: block; }
.sidebar-item:hover { background-color: var(--zy-surface-hover); color: var(--zy-text); }
.sidebar-item-active { background-color: var(--zy-primary); color: #ffffff; }
.sidebar-item-active:hover { background-color: var(--zy-primary); color: #ffffff; }

.divider { height: 1px; background-color: var(--zy-border); margin: 1.5rem 0; border: none; }

.modal-backdrop { position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.6); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 1000; }
.modal-card { background-color: var(--zy-surface); border: 1px solid var(--zy-border); border-radius: var(--zy-radius); width: 100%; max-width: 500px; padding: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4); }
.modal-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
.modal-body { color: var(--zy-text-muted); font-size: 0.875rem; margin: 1rem 0; }
.modal-footer { display: flex; justify-content: flex-end; gap: 0.5rem; }

.glass { background: rgba(255, 255, 255, 0.04); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--zy-radius); }
.shadow-xl { box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4), 0 10px 10px -5px rgba(0, 0, 0, 0.3); }
.glow-primary { box-shadow: 0 0 20px rgba(99, 102, 241, 0.35); }
.glow-accent { box-shadow: 0 0 20px rgba(56, 189, 248, 0.35); }
.transition-all { transition: all 0.2s ease-in-out; }

@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
.animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
.skeleton { background: linear-gradient(90deg, var(--zy-surface) 25%, var(--zy-surface-hover) 50%, var(--zy-surface) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: var(--zy-radius); display: block; }

.breadcrumb { display: flex; align-items: center; gap: 0.5rem; list-style: none; font-size: 0.875rem; color: var(--zy-text-muted); }
.breadcrumb-item a { color: var(--zy-text-muted); }
.breadcrumb-item a:hover { color: var(--zy-primary); }
.breadcrumb-item.active { color: var(--zy-text); font-weight: 600; }
.breadcrumb-sep { color: var(--zy-border); user-select: none; }

.tabs-container { width: 100%; }
.tabs-nav { display: flex; border-bottom: 1px solid var(--zy-border); gap: 0.5rem; margin-bottom: 1.5rem; }
.tab-btn { padding: 0.75rem 1rem; font-weight: 600; font-size: 0.875rem; color: var(--zy-text-muted); border-bottom: 2px solid transparent; cursor: pointer; background: transparent; border-top: none; border-left: none; border-right: none; transition: all 0.2s; }
.tab-btn:hover { color: var(--zy-text); }
.tab-btn.active { color: var(--zy-primary); border-bottom-color: var(--zy-primary); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

.accordion-group { border: 1px solid var(--zy-border); border-radius: var(--zy-radius); overflow: hidden; }
.accordion-item { border-bottom: 1px solid var(--zy-border); }
.accordion-item:last-child { border-bottom: none; }
.accordion-header { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; font-weight: 600; color: var(--zy-text); background: var(--zy-surface); border: none; cursor: pointer; text-align: left; font-size: 0.9375rem; }
.accordion-header:hover { background-color: var(--zy-surface-hover); }
.accordion-arrow { font-size: 1.125rem; font-weight: 700; color: var(--zy-text-muted); }
.accordion-body { padding: 1rem 1.25rem; background-color: var(--zy-bg); color: var(--zy-text-muted); font-size: 0.875rem; line-height: 1.6; }

.toast { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; background-color: var(--zy-surface); border: 1px solid var(--zy-border); border-left: 4px solid var(--zy-primary); border-radius: var(--zy-radius); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); max-width: 380px; }
.toast-info { border-left-color: var(--zy-accent); }
.toast-success { border-left-color: var(--zy-success); }
.toast-warning { border-left-color: var(--zy-warning); }
.toast-danger { border-left-color: var(--zy-danger); }
.toast-title { font-weight: 700; font-size: 0.875rem; color: var(--zy-text); margin-bottom: 0.25rem; }
.toast-msg { font-size: 0.8125rem; color: var(--zy-text-muted); }
.toast-close { background: transparent; border: none; color: var(--zy-text-muted); cursor: pointer; font-size: 1.125rem; line-height: 1; padding: 0; }
.toast-close:hover { color: var(--zy-text); }

.pagination { display: flex; align-items: center; gap: 0.375rem; list-style: none; }
.page-item { display: inline-flex; align-items: center; justify-content: center; min-width: 2.25rem; height: 2.25rem; padding: 0 0.5rem; font-size: 0.875rem; font-weight: 600; border-radius: var(--zy-radius); border: 1px solid var(--zy-border); background: var(--zy-surface); color: var(--zy-text); text-decoration: none; cursor: pointer; }
.page-item:hover { background: var(--zy-surface-hover); text-decoration: none; }
.page-item.active { background: var(--zy-primary); border-color: var(--zy-primary); color: #ffffff; }
.page-item.disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

.tooltip-wrapper { position: relative; display: inline-block; }
.tooltip-box { visibility: hidden; opacity: 0; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%); background-color: var(--zy-surface-hover); color: var(--zy-text); font-size: 0.75rem; padding: 0.35rem 0.65rem; border-radius: var(--zy-radius); white-space: nowrap; border: 1px solid var(--zy-border); z-index: 50; transition: opacity 0.2s, visibility 0.2s; pointer-events: none; }
.tooltip-wrapper:hover .tooltip-box { visibility: visible; opacity: 1; }

.dropdown { position: relative; display: inline-block; }
.dropdown-menu { display: none; position: absolute; top: calc(100% + 0.5rem); left: 0; min-width: 180px; background: var(--zy-surface); border: 1px solid var(--zy-border); border-radius: var(--zy-radius); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); padding: 0.375rem; z-index: 100; list-style: none; }
.dropdown-item { display: block; padding: 0.5rem 0.75rem; font-size: 0.875rem; color: var(--zy-text); border-radius: calc(var(--zy-radius) - 2px); text-decoration: none; cursor: pointer; }
.dropdown-item:hover { background: var(--zy-surface-hover); color: var(--zy-primary); text-decoration: none; }
.dropdown:hover .dropdown-menu, .dropdown.open .dropdown-menu { display: block; }

.code-block { background: var(--zy-surface); border: 1px solid var(--zy-border); border-radius: var(--zy-radius); overflow: hidden; margin: 1rem 0; font-family: 'JetBrains Mono', 'Fira Code', monospace; }
.code-header { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 1rem; background: var(--zy-surface-hover); border-bottom: 1px solid var(--zy-border); font-size: 0.75rem; color: var(--zy-text-muted); text-transform: uppercase; font-weight: 700; }
.code-content { padding: 1rem; overflow-x: auto; font-size: 0.875rem; line-height: 1.6; color: var(--zy-text); }
.code-content pre { margin: 0; }

.empty-state { text-align: center; padding: 3rem 1.5rem; background: var(--zy-surface); border: 2px dashed var(--zy-border); border-radius: var(--zy-radius); }
.empty-icon { font-size: 2.5rem; color: var(--zy-text-muted); margin-bottom: 1rem; display: inline-block; line-height: 1; }
.empty-title { font-size: 1.125rem; font-weight: 700; color: var(--zy-text); margin-bottom: 0.5rem; }
.empty-desc { font-size: 0.875rem; color: var(--zy-text-muted); max-width: 400px; margin: 0 auto 1.5rem auto; }

.drawer-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: 1000; display: flex; }
.drawer-left { justify-content: flex-start; }
.drawer-right { justify-content: flex-end; }
.drawer-panel { width: 100%; max-width: 380px; height: 100%; background: var(--zy-surface); border-left: 1px solid var(--zy-border); padding: 1.5rem; display: flex; flex-direction: column; box-shadow: -10px 0 25px -5px rgba(0, 0, 0, 0.4); }
.drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--zy-border); }
.drawer-title { font-size: 1.125rem; font-weight: 700; color: var(--zy-text); }
.drawer-body { flex: 1; overflow-y: auto; color: var(--zy-text-muted); font-size: 0.875rem; }
.drawer-close { background: transparent; border: none; color: var(--zy-text-muted); cursor: pointer; font-size: 1.25rem; }
.drawer-close:hover { color: var(--zy-text); }

.sparkline-svg { display: inline-block; vertical-align: middle; overflow: visible; }
"#;

  var out = vars + base_rules
  if len(&custom_css) > 0 {
    out = out + "\n" + &custom_css
  }
  return out
}

def style_attr(css: String): String {
  return "style=\"" + css + "\""
}

def class_names(classes: String): String {
  return trim(&classes)
}

def Navbar(brand: String, links_csv: String, active_link: String, actions_html: String): String {
  var nav_links = "<ul class=\"navbar-nav\">".to_string()
  const links = str.split(&links_csv, ",")
  for l in links {
    const item = trim(&l)
    if len(&item) > 0 {
      const cls = if item == active_link { "nav-link nav-link-active" } else { "nav-link" }
      nav_links = nav_links + "<li><a href=\"#\" class=\"" + cls + "\">" + &item + "</a></li>"
    }
  }
  nav_links = nav_links + "</ul>"

  return (
    <nav class="navbar">
      <div class="navbar-brand">{brand}</div>
      {nav_links}
      <div class="navbar-actions">{actions_html}</div>
    </nav>
  )
}

def Sidebar(brand: String, menu_items_csv: String, active_item: String): String {
  var menu_html = "<ul class=\"sidebar-menu\">".to_string()
  const items = str.split(&menu_items_csv, ",")
  for m in items {
    const item = trim(&m)
    if len(&item) > 0 {
      const cls = if item == active_item { "sidebar-item sidebar-item-active" } else { "sidebar-item" }
      menu_html = menu_html + "<li><a href=\"#\" class=\"" + cls + "\">" + &item + "</a></li>"
    }
  }
  menu_html = menu_html + "</ul>"

  return (
    <aside class="sidebar">
      <div class="sidebar-brand">{brand}</div>
      {menu_html}
    </aside>
  )
}

def Container(max_width: String, content: String): String {
  const cls = "container-" + max_width
  return (
    <div class={cls}>{content}</div>
  )
}

def Grid(cols: Int, content: String): String {
  const cls = format!("grid-{}", cols)
  return (
    <div class={cls}>{content}</div>
  )
}

def Card(title: String, subtitle: String, body_content: String, footer_content: String): String {
  var html = "<div class=\"card\">".to_string()
  if len(&title) > 0 || len(&subtitle) > 0 {
    html = html + "<div class=\"card-header\">"
    if len(&title) > 0 {
      html = html + "<div class=\"card-title\">" + &title + "</div>"
    }
    if len(&subtitle) > 0 {
      html = html + "<div class=\"card-subtitle\">" + &subtitle + "</div>"
    }
    html = html + "</div>"
  }
  html = html + "<div class=\"card-body\">" + &body_content + "</div>"
  if len(&footer_content) > 0 {
    html = html + "<div class=\"card-footer\">" + &footer_content + "</div>"
  }
  html = html + "</div>"
  return html
}

def SectionHeader(title: String, description: String): String {
  return (
    <div class="section-header mb-4">
      <h2 class="text-2xl font-bold">{title}</h2>
      <p class="text-muted text-sm">{description}</p>
    </div>
  )
}

def Divider(): String {
  return "<hr class=\"divider\" />".to_string()
}

def Button(label: String, variant: String, size: String, disabled: Bool): String {
  const cls = format!("btn btn-{} btn-{}", variant, size)
  if disabled {
    return (
      <button class={cls} disabled>{label}</button>
    )
  }
  return (
    <button class={cls}>{label}</button>
  )
}

def Badge(label: String, variant: String): String {
  const cls = format!("badge badge-{}", variant)
  return (
    <span class={cls}>{label}</span>
  )
}

def Alert(title: String, message: String, variant: String): String {
  const cls = format!("alert alert-{}", variant)
  return (
    <div class={cls}>
      <div class="alert-title">{title}</div>
      <div class="alert-msg">{message}</div>
    </div>
  )
}

def StatCard(title: String, value_str: String, delta_str: String, is_positive: Bool): String {
  const delta_cls = if is_positive { "stat-delta delta-positive" } else { "stat-delta delta-negative" }
  const sign = if is_positive { "+" } else { "" }
  return (
    <div class="stat-card">
      <div class="stat-title">{title}</div>
      <div class="stat-value">{value_str}</div>
      <div class={delta_cls}>{sign}{delta_str}</div>
    </div>
  )
}

def ProgressBar(progress: Int, variant: String): String {
  const fill_cls = format!("progress-fill progress-{}", variant)
  const pct = format!("width: {}%;", progress)
  return (
    <div class="progress-bg">
      <div class={fill_cls} style={pct}></div>
    </div>
  )
}

def Avatar(name: String, size: String): String {
  const initial = if len(&name) > 0 { (&name[..1]).to_uppercase() } else { "?".to_string() }
  const cls = format!("avatar avatar-{}", size)
  return (
    <div class={cls}>{initial}</div>
  )
}

def FormField(name: String, label: String, input_type: String, placeholder: String, value: String, error_msg: String): String {
  var html = "<div class=\"form-group\">".to_string()
  if len(&label) > 0 {
    html = html + "<label class=\"form-label\" for=\"" + &name + "\">" + &label + "</label>"
  }
  html = html + "<input class=\"form-input\" id=\"" + &name + "\" name=\"" + &name + "\" type=\"" + &input_type + "\" placeholder=\"" + &placeholder + "\" value=\"" + &value + "\" />"
  if len(&error_msg) > 0 {
    html = html + "<span class=\"form-error\">" + &error_msg + "</span>"
  }
  html = html + "</div>"
  return html
}

def SelectField(name: String, label: String, options_csv: String, selected_val: String): String {
  var html = "<div class=\"form-group\">".to_string()
  if len(&label) > 0 {
    html = html + "<label class=\"form-label\" for=\"" + &name + "\">" + &label + "</label>"
  }
  html = html + "<select class=\"form-select\" id=\"" + &name + "\" name=\"" + &name + "\">"
  const opts = str.split(&options_csv, ",")
  for opt in opts {
    const o = trim(&opt)
    if len(&o) > 0 {
      const is_sel = if o == selected_val { " selected" } else { "" }
      html = html + "<option value=\"" + &o + "\"" + is_sel + ">" + &o + "</option>"
    }
  }
  html = html + "</select></div>"
  return html
}

def TextareaField(name: String, label: String, rows: Int, placeholder: String, value: String): String {
  var html = "<div class=\"form-group\">".to_string()
  if len(&label) > 0 {
    html = html + "<label class=\"form-label\" for=\"" + &name + "\">" + &label + "</label>"
  }
  const rows_str = format!("{}", rows)
  html = html + "<textarea class=\"form-textarea\" id=\"" + &name + "\" name=\"" + &name + "\" rows=\"" + &rows_str + "\" placeholder=\"" + &placeholder + "\">" + &value + "</textarea></div>"
  return html
}

def CheckboxField(name: String, label: String, is_checked: Bool): String {
  const chk = if is_checked { " checked" } else { "" }
  return (
    <div class="form-group">
      <label class="form-checkbox-label">
        <input type="checkbox" name={name} class="form-checkbox" />
        <span>{label}</span>
      </label>
    </div>
  )
}

def DataTable(headers_csv: String, rows_csv: String): String {
  const headers = str.split(&headers_csv, ",")
  var thead = "<thead><tr>".to_string()
  for h in headers {
    const th = trim(&h)
    if len(&th) > 0 {
      thead = thead + "<th>" + &th + "</th>"
    }
  }
  thead = thead + "</tr></thead>"

  var tbody = "<tbody>".to_string()
  const rows = str.split(&rows_csv, ";")
  for r in rows {
    const row = trim(&r)
    if len(&row) > 0 {
      tbody = tbody + "<tr>"
      const cols = str.split(&row, ",")
      for c in cols {
        const col = trim(&c)
        tbody = tbody + "<td>" + &col + "</td>"
      }
      tbody = tbody + "</tr>"
    }
  }
  tbody = tbody + "</tbody>"

  return "<table class=\"table\">" + thead + tbody + "</table>"
}

def Modal(modal_id: String, title: String, content: String, footer: String): String {
  return (
    <div class="modal-backdrop" id={modal_id} style="display:none;">
      <div class="modal-card">
        <div class="modal-title">{title}</div>
        <div class="modal-body">{content}</div>
        <div class="modal-footer">{footer}</div>
      </div>
    </div>
  )
}

def Breadcrumb(items_csv: String): String {
  var html = "<nav class=\"breadcrumb\">".to_string()
  const items = str.split(&items_csv, ",")
  const total = len(&items)
  var idx = 0
  for l in items {
    const item = trim(&l)
    if len(&item) > 0 {
      idx = idx + 1
      if idx == total {
        html = html + "<span class=\"breadcrumb-item active\">" + &item + "</span>"
      } else {
        html = html + "<span class=\"breadcrumb-item\"><a href=\"#\">" + &item + "</a></span><span class=\"breadcrumb-sep\">/</span>"
      }
    }
  }
  html = html + "</nav>"
  return html
}

def Tabs(tab_labels_csv: String, active_tab: String, panels_html: String): String {
  var nav_html = "<div class=\"tabs-nav\">".to_string()
  const tabs = str.split(&tab_labels_csv, ",")
  for t in tabs {
    const tab = trim(&t)
    if len(&tab) > 0 {
      const slug = "tab-" + &str.lower(&tab)
      const cls = if tab == active_tab { "tab-btn active" } else { "tab-btn" }
      nav_html = nav_html + "<button class=\"" + cls + "\" data-tab-target=\"" + &slug + "\">" + &tab + "</button>"
    }
  }
  nav_html = nav_html + "</div>"
  return "<div class=\"tabs-container\">" + nav_html + "<div class=\"tabs-content\">" + &panels_html + "</div></div>"
}

def TabPanel(tab_name: String, is_active: Bool, content: String): String {
  const slug = "tab-" + &str.lower(&tab_name)
  const cls = if is_active { "tab-panel active" } else { "tab-panel" }
  return "<div class=\"" + cls + "\" id=\"" + slug + "\">" + &content + "</div>"
}

def Accordion(title: String, content: String, is_open: Bool): String {
  const arrow = if is_open { "-" } else { "+" }
  const body_style = if is_open { "" } else { " style=\"display:none;\"" }
  return "<div class=\"accordion-item\"><button class=\"accordion-header\" data-accordion-toggle><span>" + &title + "</span><span class=\"accordion-arrow\">" + arrow + "</span></button><div class=\"accordion-body\"" + body_style + ">" + &content + "</div></div>"
}

def Toast(title: String, message: String, variant: String): String {
  const cls = "toast toast-" + &variant
  return "<div class=\"" + cls + "\"><div><div class=\"toast-title\">" + &title + "</div><div class=\"toast-msg\">" + &message + "</div></div><button class=\"toast-close\" data-toast-close>&times;</button></div>"
}

def Pagination(current_page: Int, total_pages: Int): String {
  var html = "<nav class=\"pagination\">".to_string()
  const prev_cls = if current_page <= 1 { "page-item disabled" } else { "page-item" }
  html = html + "<a href=\"#\" class=\"" + prev_cls + "\">&laquo;</a>"
  for p in 1..=total_pages {
    const p_str = format!("{}", p)
    const active_cls = if p == current_page { "page-item active" } else { "page-item" }
    html = html + "<a href=\"#\" class=\"" + active_cls + "\">" + &p_str + "</a>"
  }
  const next_cls = if current_page >= total_pages { "page-item disabled" } else { "page-item" }
  html = html + "<a href=\"#\" class=\"" + next_cls + "\">&raquo;</a>"
  html = html + "</nav>"
  return html
}

def Tooltip(text: String, content_html: String): String {
  return "<div class=\"tooltip-wrapper\">" + &content_html + "<div class=\"tooltip-box\">" + &text + "</div></div>"
}

def Dropdown(button_label: String, items_csv: String): String {
  var items_html = "<ul class=\"dropdown-menu\">".to_string()
  const items = str.split(&items_csv, ",")
  for it in items {
    const item = trim(&it)
    if len(&item) > 0 {
      items_html = items_html + "<li><a class=\"dropdown-item\" href=\"#\">" + &item + "</a></li>"
    }
  }
  items_html = items_html + "</ul>"
  return "<div class=\"dropdown\"><button class=\"btn btn-secondary btn-sm\">" + &button_label + " &#9662;</button>" + items_html + "</div>"
}

def Skeleton(variant: String, width: String, height: String): String {
  const rad = if variant == "circle" { "border-radius: 50%;" } else { "" }
  const style = "width: " + &width + "; height: " + &height + "; " + rad
  return "<div class=\"skeleton\" style=\"" + &style + "\"></div>"
}

def CodeBlock(code: String, language: String): String {
  return "<div class=\"code-block\"><div class=\"code-header\"><span>" + &language + "</span><button class=\"btn btn-ghost btn-sm\" onclick=\"navigator.clipboard.writeText(this.closest('.code-block').querySelector('pre').innerText)\">Copy</button></div><div class=\"code-content\"><pre><code>" + &code + "</code></pre></div></div>"
}

def EmptyState(title: String, description: String, action_html: String): String {
  return "<div class=\"empty-state\"><div class=\"empty-icon\">&#9671;</div><div class=\"empty-title\">" + &title + "</div><div class=\"empty-desc\">" + &description + "</div><div class=\"empty-action\">" + &action_html + "</div></div>"
}

def Drawer(drawer_id: String, title: String, content: String, is_right: Bool): String {
  const side = if is_right { "drawer-right" } else { "drawer-left" }
  return "<div class=\"drawer-backdrop " + side + "\" id=\"" + &drawer_id + "\" style=\"display:none;\"><div class=\"drawer-panel\"><div class=\"drawer-header\"><div class=\"drawer-title\">" + &title + "</div><button class=\"drawer-close\" data-drawer-close>&times;</button></div><div class=\"drawer-body\">" + &content + "</div></div></div>"
}

def Sparkline(points_str: String, color: String, height: Int): String {
  const stroke = if contains(&color, "#") || contains(&color, "rgb") { color } else { "var(--zy-" + &color + ")" }
  const h_str = format!("{}", height)
  return "<svg class=\"sparkline-svg\" width=\"120\" height=\"" + &h_str + "\" viewBox=\"0 0 120 " + &h_str + "\"><polyline points=\"" + &points_str + "\" fill=\"none\" stroke=\"" + &stroke + "\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" /></svg>"
}

def render_themed_page(title: String, body_html: String, theme: Theme, custom_css: String): String {
  const head = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>" + title + "</title>\n"
  const styles = "  <style>\n" + generate_stylesheet(theme, custom_css) + "\n  </style>\n</head>\n<body>\n"
  const client_script = r#"  <script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-tab-target]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = btn.getAttribute('data-tab-target');
      var container = btn.closest('.tabs-container');
      container && container.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
      container && container.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      btn.classList.add('active');
      var panel = container ? container.querySelector('#' + target) : null;
      panel && panel.classList.add('active');
    });
  });
  document.querySelectorAll('[data-accordion-toggle]').forEach(function(hdr) {
    hdr.addEventListener('click', function() {
      var item = hdr.closest('.accordion-item');
      var body = item ? item.querySelector('.accordion-body') : null;
      var arrow = item ? item.querySelector('.accordion-arrow') : null;
      var isHidden = body && body.style.display === 'none';
      body && (body.style.display = isHidden ? 'block' : 'none');
      arrow && (arrow.textContent = isHidden ? '-' : '+');
    });
  });
  document.querySelectorAll('[data-modal-open]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var m = document.getElementById(btn.getAttribute('data-modal-open'));
      m && (m.style.display = 'flex');
    });
  });
  document.querySelectorAll('[data-modal-close]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var m = btn.closest('.modal-backdrop');
      m && (m.style.display = 'none');
    });
  });
  document.querySelectorAll('[data-drawer-open]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var d = document.getElementById(btn.getAttribute('data-drawer-open'));
      d && (d.style.display = 'flex');
    });
  });
  document.querySelectorAll('[data-drawer-close]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var d = btn.closest('.drawer-backdrop');
      d && (d.style.display = 'none');
    });
  });
  document.querySelectorAll('[data-toast-close]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var t = btn.closest('.toast');
      t && t.remove();
    });
  });
});
  </script>
"#;
  const body = "  <div id=\"app\">\n    " + body_html + "\n  </div>\n" + client_script + "</body>\n</html>"
  const doc = head + &styles + &body
  return doc
}

def render_page(title: String, body_html: String): String {
  return render_themed_page(title, body_html, theme_dark(), "".to_string())
}

def render_dashboard(title: String, brand: String, nav_links_csv: String, active_nav: String, content_html: String, theme: Theme): String {
  const nav = Navbar(brand, nav_links_csv, active_nav, "<button class=\"btn btn-primary btn-sm\">+ New Project</button>".to_string())
  const layout = "<div class=\"min-h-screen\">" + nav + "<main class=\"container\">" + content_html + "</main></div>"
  return render_themed_page(title, layout, theme, "".to_string())
}