@test
def test_tabs_and_breadcrumb(): Int {
  const crumbs = Breadcrumb("Home, Projects, zyra-ui, Settings".to_string())
  if (!contains(crumbs, "class=\"breadcrumb\"") || !contains(crumbs, "<span class=\"breadcrumb-item active\">Settings</span>") || !contains(crumbs, "<span class=\"breadcrumb-sep\">/</span>") || !contains(crumbs, "Projects")) {
    print("[FAIL] Breadcrumb rendering failed")
    return 1
  }

  const p1 = TabPanel("Overview".to_string(), true, "<p>Overview Panel</p>".to_string())
  const p2 = TabPanel("Metrics".to_string(), false, "<p>Metrics Panel</p>".to_string())
  const tabs = Tabs("Overview, Metrics, Logs".to_string(), "Overview".to_string(), p1 + &p2)

  if (!contains(tabs, "class=\"tabs-container\"") || !contains(tabs, "data-tab-target=\"tab-overview\"") || !contains(tabs, "tab-btn active") || !contains(tabs, "tab-panel active") || !contains(tabs, "Overview Panel")) {
    print("[FAIL] Tabs rendering failed")
    return 1
  }

  print("[PASS] Tabs and Breadcrumb components verified")
  return 0
}

@test
def test_accordion_and_toast(): Int {
  const acc_open = Accordion("Cluster Nodes".to_string(), "<p>Node 1 online</p>".to_string(), true)
  if (!contains(acc_open, "accordion-item") || !contains(acc_open, "data-accordion-toggle") || !contains(acc_open, "Node 1 online") || contains(acc_open, "display:none;")) {
    print("[FAIL] Open accordion rendering failed")
    return 1
  }

  const acc_closed = Accordion("Storage Volumes".to_string(), "<p>Vol 2 attached</p>".to_string(), false)
  if (!contains(acc_closed, "display:none;") || !contains(acc_closed, "Storage Volumes")) {
    print("[FAIL] Closed accordion rendering failed")
    return 1
  }

  const toast = Toast("Deployment Live".to_string(), "Production release v2.5.0 ready".to_string(), "success".to_string())
  if (!contains(toast, "toast toast-success") || !contains(toast, "data-toast-close") || !contains(toast, "Deployment Live") || !contains(toast, "Production release v2.5.0 ready")) {
    print("[FAIL] Toast rendering failed")
    return 1
  }

  print("[PASS] Accordion and Toast components verified")
  return 0
}

